@article{afan2018adaptive,
  title = {An adaptive method for identifying marine areas of high conservation priority},
  author = {Af{\'a}n, Isabel and Gim{\'e}nez, Joan and Forero, Manuela G and Ram{\'i}rez, Francisco},
  journal = {Conservation Biology},
  volume = {32},
  number = {6},
  pages = {1436--1447},
  year = {2018},
  publisher = {Wiley Online Library},
  abstract = {We used the Patagonian seabird breeding community as a case study to propose an integrated and adaptive method for delimiting key marine areas for conservation. Priority areas were defined through a free decision-support tool (Marxan) that included projected at-sea distributions of seabirds (approximately 2,225,000 individuals of 14 species); BirdLife Important Bird and Biodiversity Areas (IBAs) for pelagic bird species; and the economic costs of potential regulations in fishing practices.},
  island = {Patagonian coast, Argentina},
  species = {Penguins; Albatrosses; Petrels; Shearwaters; Cormorants; Gulls; Terns; Skuas},
  time_period = {1993-2017},
  research_question = {How can key marine areas for seabird conservation be delimited in a large, remote and continuous system where tracking data are scarce and the conservation effort must compete with fisheries?},
  objectives = {To project the at-sea distribution of the Patagonian seabird breeding community from colony censuses and known foraging ranges; To delimit priority areas fulfilling species-specific conservation targets while minimizing the economic costs of potential fishing regulations; To identify the water masses that may influence those priority areas through marine current inflow},
  variables = {Projected at-sea distribution of 14 breeding species; Species conservation targets; Important Bird and Biodiversity Areas; Fishing effort; Marine currents; Resistance layers; Chlorophyll-a concentration; Point-source pollution},
  analytical_methods = {Hanski's (1998) isolation function to project at-sea distributions; Marxan systematic conservation planning with 500 runs; BirdLife marine IBA inclusion in two scenarios; Circuit theory connectivity modelling in Circuitscape; Chlorophyll-a time-series analysis from SeaWiFS and MODIS sensors},
  results = {The IBAs scenario covered 280,000 km2 (4495 planning units) across up to 20 priority areas, exceeding the 20% protection target for species of least concern (41.1-87.3%) and 30% for near-threatened species (30-66.6%); Adding IBAs to the reference solution reached 330,000 km2 (6281 planning units) in 23 areas, with targets met for all species (46.5-89.6% least concern, 44.2-73.5% near-threatened); Three primary water masses were identified as potentially influencing the priority areas through water inflow},
  equations = {Isolation function for projecting at-sea distribution from colony size and foraging range; Marxan cost and benefit functions; Circuit theory effective resistance between nodes},
  software = {Marxan version 1.8.10; Zonae Cogito; Circuitscape},
  limitations = {Lack of species and colony-specific foraging distribution data; Foraging distances not modelled as varying with colony size or sea area; Individuals breeding outside the study area excluded from at-sea projections but included in reserve design via IBAs; Fishing effort used as a proxy for both economic cost and bycatch impact; No guidelines exist for using pelagic IBAs in marine protected area delimitation; Network could be meaningless outside the breeding season},
  keywords = {Marine protected areas; Marxan; Ocean currents; Remote sensing; Reserve design; Seabird at-sea distribution},
  category = {NA},
}

@article{beal2021track2kba,
  title = {track2KBA: An R package for identifying important sites for biodiversity from tracking data},
  author = {Beal, Martin and Oppel, Steffen and Handley, Jonathan and Pearmain, Elizabeth J and Morera-Pujol, Virginia and Carneiro, Ana PB and Davies, Tammy E and Phillips, Richard A and Taylor, Philip R and Miller, Mark GR and others},
  journal = {Methods in Ecology and Evolution},
  volume = {12},
  number = {12},
  pages = {2372--2378},
  year = {2021},
  publisher = {Wiley Online Library},
  abstract = {We introduce the R package 'track2KBA', a tool to identify important sites at the population level using tracking data from individual animals based on three key steps: (a) identifying individual core areas, (b) assessing population-level representativeness of the sample and (c) quantifying spatial overlap among individuals and scaling up to the population. We describe package functionality and exemplify its application using tracking data from three taxa in contrasting environments: a seal, a marine turtle and a migratory land bird.},
  island = {not_applicable},
  species = {Antarctic fur seals; Green sea turtles; White storks},
  time_period = {not_applicable},
  research_question = {How can tracking data from individual animals be turned into sites of ecological relevance that can be assessed against systematic criteria such as the Key Biodiversity Area Standard?},
  objectives = {To introduce an R package that identifies individual core areas, assesses population-level representativeness of the tracking sample, and quantifies spatial overlap among individuals scaled to the population; To exemplify the package on tracking data from three taxa in contrasting environments; To show how the output supports site delineation under the Key Biodiversity Area Standard},
  variables = {Individual core areas; Sample representativeness; Spatial overlap among individuals; Source population size; Smoothing parameter h; Probability quantile of the utilization distribution; Grid resolution for KDE; Grid cells used by a threshold proportion of the population},
  analytical_methods = {Kernel density estimation of the utilization distribution via estSpaceUse; Iterative subsampling and pooled functions via repAssess to estimate representativeness and the asymptote; Population scaling and site delineation via findSite using a threshold proportion of individuals; Illustrative applications to three tracking datasets},
  results = {The package provides four functions and nine accessory functions covering the workflow from splitting tracks into events to delineating and plotting sites; The worked Antarctic fur seal example estimated 96% representativeness for 117 tracked individuals and delineated areas used by at least 10% of the local population; The workflow produces output that can be assessed against the Key Biodiversity Area Standard for conservation planning at global and regional levels},
  equations = {Kernel density estimation of the utilization distribution; Representativeness estimated as the proportion of out-of-sample locations within a subsample-derived utilization distribution; Population scaling from the estimated proportion of individuals predictably using each grid cell},
  software = {track2KBA},
  limitations = {Kernel bandwidth h must be chosen by the user and affects the spatial estimate; The grid resolution and probability quantile both require user selection, and 50% is a standard rather than fixed choice; Requires the size of the source population to be known or estimated for population scaling},
  keywords = {Animal movement; Biologging; Important Bird and Biodiversity Areas; Key biodiversity areas; Protected areas; Site-based conservation; Utilization distribution},
  category = {NA},
}

@article{birdlife2018phoebastria,
  title = {Phoebastria immutabilis. The IUCN Red List of Threatened Species 2018: e.T22698365A132643073},
  author = {BirdLife International},
  journal = {The IUCN Red List of Threatened Species 2018},
  number = {e.T22698365A132643073},
  year = {2018},
  publisher = {International Union for Conservation of Nature and Natural Resources},
  doi = {10.2305/IUCN.UK.2018-2.RLTS.T22698365A132643073.en},
  abstract = {This species has rebounded from declines in the late 1990s and early 2000s, perhaps because apparent changes in the breeding populations reflected large scale environmental conditions that affected the number of birds that returned to the colonies to nest rather than actual declines in the population. Given the difficulty of predicting long-term trends for such a long-lived species, and the number of documented threats and the uncertainty over their future effects, the species is precautionarily projected to undergo a moderately rapid population decline over three generations (84 years).},
  island = {North Pacific},
  species = {Laysan Albatross},
  time_period = {1980-2018},
  research_question = {not_applicable},
  objectives = {To assess the extinction risk of Phoebastria immutabilis against the IUCN Red List criteria; To project the population trend over three generations; To summarise documented threats and conservation actions for the species},
  variables = {Breeding population size; Population trend; Number of breeding sites; Threats; Conservation actions; Red List category},
  analytical_methods = {IUCN Red List Categories and Criteria version 3.1, criterion A4bd; Projection of population decline over three generations (84 years); Compilation of published and unpublished records on distribution, demography, threats and conservation actions},
  results = {Assessed as Near Threatened; Population estimated at more than 800,000 breeding pairs, equivalent to about 1,600,000 mature individuals; Midway Atoll, Laysan Island and French Frigate Shoals support 90% of the global breeding population; A 32% decline was recorded during 1992-2002 in the Northwestern Hawaiian Islands but the overall trend for 1992-2005 is stable; A precautionary decline of 20-29% over 1992-2078 is estimated; The Mexican population is about 400 pairs at four sites, less than 0.1% of the global population},
  equations = {Red List criterion A4 thresholds for population reduction over a generation length; Three-generation projection for a long-lived species},
  software = {not_applicable},
  limitations = {Long-term trends are difficult to predict for a long-lived species; Apparent changes in breeding populations may reflect environmental conditions affecting return to colonies rather than actual population change; Bycatch rates in Japanese and Taiwanese pelagic longline fisheries remain largely unknown; Breeding populations were extirpated from Wake and Johnston atolls and Minami Torishima, so data from some sites are absent},
  keywords = {not_applicable},
  category = {NA},
}

@article{brito2011captura,
  title = {Captura incidental de aves marinas por la pesquer\'ia artesanal de la costa occidental de Baja California, M\'exico},
  author = {Brito Chavarr\'ia, Mariela},
  year = {2011},
  abstract = {This study evaluated the mortality of seabirds due to interactions with artisanal fisheries off the west coast of Baja California, Mexico, through 100 semi-structured interviews at 13 fishing camps in 2010. Bycatch mortality was estimated at 621 birds over the year, with cormorants (Phalacrocorax spp.) comprising the largest proportion. Maximum mortality occurred in summer and autumn, which were significantly different from winter and spring. Fishing nets and lobster traps were the principal gears interacting with seabirds, and no mortality was recorded for pelagic longlines, fish traps or crab traps.},
  island = {West coast, Baja California, Mexico},
  species = {Cormorants; shearwaters},
  time_period = {2010},
  research_question = {What is the bycatch mortality of seabirds due to interactions with artisanal fisheries along the west coast of Baja California, Mexico?},
  objectives = {To describe the artisanal fisheries of the region; To identify whether there was a relationship between fishing gear type and the seabird species caught; To identify which season had the highest seabird mortality from fishing operations; To determine geographic zones where interaction between seabirds and fisheries occurs},
  variables = {Seabird bycatch mortality; Fishing gear type; Season; Geographic zone; Catch per unit effort related to interactions},
  analytical_methods = {Semi-structured interviews at 13 fishing camps (100 interviews total) in 2010; Two-way ANOVA to test differences in mortality between seasons and zones; Estimation of annual bycatch mortality based on interview data; Identification of gear types involved},
  results = {Estimated bycatch mortality of 621 seabirds over 2010; Cormorants (Phalacrocorax spp.) were the most frequent bycaught birds; Mortality was highest in summer and autumn and significantly different from winter and spring; Fishing nets and lobster traps were the main gears interacting with seabirds; No mortality recorded for pelagic longlines, fish traps or crab traps; The study provides the first evaluation of seabird mortality attributed to artisanal fisheries in Mexico},
  equations = {Catch per unit effort estimates derived from interview responses; Statistical comparison by season and zone via two-way ANOVA},
  software = {not_applicable},
  limitations = {The information is based on interviews rather than direct observer data; Only one count was performed for cormorant numbers and not all known breeding colonies were surveyed; Population estimates for the affected cormorant species are limited and data from 2005 to the present are scarce; The study relied on fishers' recall to estimate annual bycatch numbers},
  keywords = {Incidental catch; Seabirds; Artisanal fisheries; Mexico},
  category = {NA},
}

@article{brothers1999incidental,
  title = {The incidental catch of seabirds by longline fisheries: worldwide review and technical guidelines for mitigation},
  author = {Brothers, Nigel P. and Cooper, John and L{\o}kkeborg, Svein},
  journal = {FAO Fisheries Circular},
  volume = {937},
  pages = {1--100},
  year = {1999},
  publisher = {Food and Agriculture Organization of the United Nations},
  abstract = {Certain longline fisheries result in large numbers of seabirds being hooked on setting lines. Species of seabirds most commonly taken are the albatrosses and large petrels of the family Procellariidae. A comprehensive number of mitigation measures for reducing the incidental catch of seabirds in longline fisheries has been developed during the past 5-10 years.},
  island = {Global},
  species = {Albatrosses; Petrels},
  time_period = {not_applicable},
  research_question = {How can the incidental catch of seabirds in longline fisheries be reduced worldwide through technical mitigation measures?},
  objectives = {To describe longline fishing methods, gear configuration and operation; To review the bycatch of seabirds in specific longline fisheries worldwide; To review longline seabird bycatch mitigation measures and their effect on other marine species},
  variables = {Longline fishing effort; Seabird bycatch rates; Hooking rate; Gear configuration; Mitigation measure types; Vessel fishers},
  analytical_methods = {Worldwide review of published and grey literature and fishery statistics; Compilation of three background papers into one document; Description of gear configuration and mitigation measures; Compilation of estimated annual bycatch data from monitored fisheries},
  results = {Identifies the major problem fisheries as demersal fisheries of the Northeast Pacific, North Atlantic, Southern Ocean and the Atlantic coast of South America, and tuna pelagic fisheries of cool temperate seas in the North Pacific and Southern Ocean; Albatrosses and large petrels of the family Procellariidae are the seabirds most commonly taken; A comprehensive set of mitigation measures has been developed over the past 5-10 years and, with widespread use, a significant reduction in incidental catch is achievable at minimal cost},
  equations = {not_applicable},
  software = {not_applicable},
  limitations = {Data on incidental catch are lacking for a number of longline fisheries including the Pacific coast of South America, the Mediterranean Sea and tropical waters of all oceans; Some mitigation measures exist only as concepts requiring investigation and development; Unpublished and grey literature contributed to the review},
  keywords = {Longline fisheries; Seabird bycatch; Mitigation measures; Procellariidae; National Plans of Action},
  category = {NA},
}

@article{clay2023adjustment,
  title = {Adjustment of foraging trips and flight behaviour to own and partner mass and wind conditions by a far-ranging seabird},
  author = {Clay, Thomas A and Hodum, Peter and Hagen, Erin and Brooke, M de L},
  journal = {Animal Behaviour},
  volume = {198},
  pages = {165--179},
  year = {2023},
  publisher = {Elsevier},
  abstract = {Outbound and return journeys appeared to broadly benefit from predictable southeasterly trade and westerly winds, respectively. Over finer scales, departure bearings were influenced by wind directions. Across trips, birds oriented predominantly with quartering tail winds which maximized ground speeds. Individuals experienced variable support from tail winds, and those that benefited more on outbound journeys (when winds were generally weaker) travelled faster, reached foraging areas more quickly and, over the entire trip, had higher mass gain per day at sea.},
  island = {Isla Alejandro Selkirk, Juan Fern\'andez Archipelago, Chile},
  species = {Juan Fern\'andez petrel},
  time_period = {December 2019 to February 2020},
  research_question = {It is little known how Juan Fern\'andez petrels adjust their foraging trips and flight behaviour to wind conditions and to their own and their partner's mass during breeding},
  objectives = {Classify at-sea behavioural states with hidden Markov models and compare routes with mean wind conditions to test the prediction of large-scale anticlockwise looping trips that follow prevailing winds (H1a); Test how finely birds tune routes and flight behaviour to the wind they encounter, including departure bearings (H1b--H1d); Test whether own and partner mass influence trip duration, maximum range, and mass gain (H2a, H2b); Test whether more efficient use of tail winds increases trip success, measured as trip duration and mass gain (H3)},
  variables = {Departure and return mass of tracked birds; Mass of the partner at departure; Zonal and meridional wind components, wind speed, and wind direction; Average tail wind support (Vtw); Ground speed; Trip duration; Maximum range from the colony; Cumulative distance travelled; Path sinuosity; Time spent in directed flight, area-restricted search, and rest; Immersion activity as a proxy for prey capture; Foraging area as the 50% kernel utilisation distribution of area-restricted search locations},
  analytical_methods = {Deploy GPS and immersion loggers on incubating birds and weigh each tracked bird and its partner; Filter locations implying flight speeds above 90 km/h and interpolate tracks to 40 min intervals; Link GPS fixes to ERA5 reanalysis wind data; Fit multivariate hidden Markov models with three states (directed flight, area-restricted search, rest) from step lengths and turning angles, using the Viterbi algorithm; Calculate 50% kernel utilisation distributions of foraging areas and compare them with wind climatology; Model departure bearings with circular-circular regression; Test effects on trip duration, maximum range, path sinuosity, and mass gain with generalized additive models},
  results = {Trips averaged 20.4 days and 10741 km; Foraging areas lay about 3400 km west of the colony in the southeastern Pacific Ocean; Birds spent 45.8% of time in directed flight (SD 7.5%), 40.0% in area-restricted search (SD 4.9%), and 14.2% resting (SD 3.6%); Outbound and return legs followed southeasterly trade and westerly winds respectively; Birds gained around a quarter of their departure mass; Birds lighter on departure gained more mass; Birds with heavier partners ranged further, contrary to prediction; Greater outbound tail wind support brought faster travel and higher daily mass gain, but not shorter trips or more total mass},
  equations = {Wind speed (Vw) as the vector magnitude of the zonal and meridional wind components; Wind direction (qw) as the two-argument arctangent of those components, expressed in degrees},
  software = {R v4.0.3; momentuHMM; adehabitatLT; trip; track2kba; raster; fields; adehabitatHR; circular; mgcv; maptools; multcomp; lmtest},
  limitations = {Mass of partners for birds returning above 600 g was back-calculated from a daily mass loss estimate instead of measured directly; Five individuals could not be reweighed before fieldwork ended, reducing the sample size for return mass and mass gain; The group carrying geolocator-immersion loggers only had a particularly small sample size; The observational design and modest sample size do not allow between-pair and within-pair effects to be separated; At 40 min GPS resolution, finescale foraging behaviour may be unresolved},
  keywords = {Body condition; Gadfly petrel; Hidden Markov model; Incubation; Mass gain; Movement ecology; Pair coordination; Pterodroma; Wind},
  category = {NA},
}

@article{copello2014spatial,
  title = {Spatial overlap of Black-browed albatrosses with longline and trawl fisheries in the Patagonian Shelf during the non-breeding season},
  author = {Copello, Sof\'ia and Pon, Juan Pablo Seco and Favero, Marco},
  journal = {Journal of Sea Research},
  volume = {89},
  pages = {44--51},
  year = {2014},
  publisher = {Elsevier},
  abstract = {The overlap index showed highest values with both coastal fleets, followed by the ice-chilling trawl fleet. These intersections were located in the Argentine-Uruguay Common Fishing Zone, in coastal areas of the SE of Buenos Aires province, El Rinc\'{o}n estuary and over the shelf break. The analysis of intersections of focal areas from albatrosses and all fisheries allowed us the identification of thirty-four fishing management units (1 degree by 1 degree grid within the Argentine EEZ) classified as of medium, high or very high conservation priority.},
  island = {Argentine Patagonian Shelf and Argentine-Uruguay Common Fishing Zone, Argentina},
  species = {Black-browed albatross},
  time_period = {Austral winters (June--September) 2011 and 2012 for bird tracking; winter 2011 for vessel monitoring system data},
  research_question = {It is unknown how much the non-breeding distribution of Black-browed albatrosses overlaps the different Argentine fishing fleets, and therefore where conservation effort is most needed},
  objectives = {Model the degree of spatial overlap between Black-browed albatrosses and the Argentine fisheries known to pose a threat, using satellite telemetry and vessel monitoring system data; Compare the at-sea distributions of birds and of six fleets with kernel utilization distributions and quantify overlap with the utilization distribution overlap index; Identify the locations where bird and fleet focal areas intersect; Classify 1 degree by 1 degree management units of the Argentine EEZ by the extent of overlap to identify areas of medium, high, and very high conservation priority},
  variables = {Albatross at-sea position fixes; Vessel monitoring system positions of fishing vessels; Fishing effort by fleet; Kernel utilization distribution core (50%), focal (75%), and range (95%) areas of birds and of fleets; Utilization distribution overlap index (UDOI); Proportion of each 1 degree by 1 degree management unit covered by the bird-fishery intersection; Conservation priority class (medium, high, very high)},
  analytical_methods = {Filter Argos locations by flight speed and re-sample tracks at 30 min intervals; Filter vessel monitoring system positions by speed and time of day to represent fishing effort; Model at-sea distributions of birds and fleets with kernel utilization distributions, a 50 km smoothing parameter, and 50%, 75%, and 95% contours; Quantify overlap with the utilization distribution overlap index and compare with a Kruskal-Wallis test; Intersect bird and fleet utilization distributions as a proxy of mortality risk; Aggregate the 75% focal intersections into a 1 degree grid, weighting cells by surface covered and classifying medium, high, or very high risk},
  results = {4,863 fixes from 11 birds tracked up to 107 days; Birds ranged from 29 to 51 degree S, off Argentina, Uruguay, and southern Brazil; Overlap was highest with coastal trawlers (UDOI 50% = 0.012 and 0.013) and ice-chilling trawlers (0.010), and there was none with demersal longliners; Differences were significant only between longliners and both coastal fleets (P < 0.05); Thirty-four 1 degree management units, 17% of those in the EEZ, were of medium, high, or very high priority; Very high priority units lay at the mouth of the Rio de la Plata and east of the hake closure},
  equations = {Utilization distribution overlap index (UDOI) of Fieberg and Kochanny (2005), bounded between 0 and 1; Grid risk weight as the proportion of a management unit surface covered by the 75% focal area intersection},
  software = {R 2.15; adehabitat; ArcGIS 10.0; Argos System; Satellite Tracking and Analysis Tool},
  limitations = {Only 11 birds were tracked, so the sample size is limited; Captures for tag deployment occurred at two locations in central-north Patagonia (38 degree S and 42 degree S), which may have caused underestimation or no identification of risk areas in southern waters, in particular to the south of breeding sites},
  keywords = {Thalassarche melanophris; Argentine fisheries; Vessel monitoring system; Satellite tracking; At sea distribution; Conservation priority areas},
  category = {NA},
}

@article{critchley2018marine,
  title = {Marine protected areas show low overlap with projected distributions of seabird populations in Britain and Ireland},
  author = {Critchley, Emma Jane and Grecian, W James and Kane, Adam and Jessopp, Mark J and Quinn, John L},
  journal = {Biological Conservation},
  volume = {224},
  pages = {309--317},
  year = {2018},
  publisher = {Elsevier},
  abstract = {Marine Protected Areas (MPAs) are an important tool for the conservation of seabirds. However, mapping seabird distributions using at-sea surveys or tracking data to inform the designation of MPAs is costly and time-consuming, particularly for far-ranging pelagic species. Here we explore the potential for using predictive distribution models to examine the effectiveness of current MPAs for the conservation of seabirds, using Britain and Ireland as a case study.},
  island = {Britain and Ireland},
  species = {All seabird species breeding in Britain and Ireland (25 species)},
  time_period = {Breeding season; colony counts from most recent censuses, about 3% uncensused in the last 30 years},
  research_question = {Whether predictive distribution models can assess the effectiveness of existing marine protected areas for seabirds when mapping at-sea distributions with surveys or tracking data is too costly, particularly for far-ranging pelagic species},
  objectives = {Project at-sea distributions for the whole seabird community of Britain and Ireland using a distance-weighted foraging radius approach; Identify hotspots of highest density and species richness; Quantify the percentage overlap between projected distributions and existing protected areas at the level of species, family group, foraging range group, and conservation status; Compare overlap between coastal and pelagic foragers and between threatened and non-threatened species},
  variables = {Colony location; Colony population size; Maximum foraging range; Foraging range group (coastal or pelagic); European conservation status; Proportion of the European population in Britain and Ireland; Projected number of individuals per grid cell; Species richness per grid cell; Protected area type (SPA, OSPAR MPA); Percentage of the projected at-sea population inside protected areas},
  analytical_methods = {Collate open-access colony data for 25 breeding species from the JNCC Seabird Monitoring Programme; Project distributions on a 5 by 5 km grid by inverting distance from colony, normalising to 0--1, weighting by the inverse log distance from the colony, and assuming 50% of a breeding pair forages at sea; Exclude land so birds cannot cross it; Sum across colonies, species, eight family groups, and two foraging range groups, splitting coastal from pelagic at a 75 km maximum foraging range; Merge protected area polygons by type to avoid double counting; Test overlap differences with a Wilcoxon rank sum test},
  results = {Overlap was significantly higher for coastal species (mean 32.5%) than for pelagic species (13.2%, p < 0.001); The difference held under SPAs (18.1% against 2.4%) and OSPAR MPAs (25.5% against 11.9%); Non-threatened species had higher coverage than threatened species (25.0% against 14.3%), significant for SPAs (p = 0.01) but not for OSPAR MPAs (p = 0.09) or all protected areas (p = 0.07); Species overlap ranged from under 7% (European storm-petrel) to over 70% (Mediterranean gull)},
  equations = {Distance-decay weighting of grid cells by the inverse log distance from the colony; Not applicable otherwise, the approach is described in five procedural steps rather than formulae},
  software = {R version 3.2.1; ggplot2 version 2.00},
  limitations = {Projection models cannot account for spatio-temporal variation in oceanic, meteorological, and ecological factors, so patchy resource distribution and variable prey availability are not represented; The proportion of a population at sea varies with time of day and season, so values are representative only of the period when most foraging occurs; About 3% of colonies had not been censused in the last 30 years; Protected areas near colonies do not necessarily serve the species needing most protection, since most foraging by pelagic species occurs offshore},
  keywords = {Seabirds; Protected areas; Predictive modelling; Hotspots; Foraging; Ecosystem approach},
  category = {NA},
}

@article{curk2024integrating,
  title = {Integrating threat mapping and animal movement data to identify high-risk areas for endangered mobile species},
  author = {Curk, T and Melzheimer, J and Aschenborn, O and Amar, A and Kolberg, H and Garbett, R and Maude, G and Reading, RP and Selebatso, M and Berzaghi, F and others},
  journal = {Animal Conservation},
  year = {2024},
  publisher = {Wiley Online Library},
  doi = {10.1111/acv.12980},
  url = {https://doi.org/10.1111/acv.12980},
  abstract = {We identified poisoning hotspots in northern Botswana and south-eastern Namibia. These areas were also associated with a high number of vulture mortalities, providing additional support for poisoning risk. Northern Botswana and areas at the border between Botswana and South Africa were characterized by high food availability, potentially amplifying the mortality rate by attracting vultures from surrounding areas.},
  island = {Northern Botswana, south-eastern Namibia, and the border between Botswana and South Africa, Southern Africa},
  species = {Lappet-faced vulture},
  time_period = {GPS tracking 2012 to 2022; poisoning records 2000 to 2023},
  research_question = {How can the spatial exposure of mobile species to anthropogenic threats be quantified and mapped, illustrated with poisoning risk to an endangered vulture species},
  objectives = {Introduce a framework for quantifying exposure of mobile species to spatially explicit threats; Illustrate the framework with poisoning risk in the Lappet-faced vulture; Combine GPS tracking with food availability and intentional and unintentional poisoning maps across Southern Africa; Identify poisoning hotspots and test whether space use and vulture numbers increase with poisoning and food availability; Test sensitivity to the extrapolated unintentional poisoning values for Botswana},
  variables = {Individual space use as a proportional probability of occupying a 10 km cell; Number of vultures occupying a cell; Intentional poisoning prevalence; Unintentional poisoning prevalence; Food availability; Reported vulture mortalities; Individual annual trajectory identity as a random effect},
  analytical_methods = {Capture 20 adult vultures with solar GPS tags and retain 19, thinning positions to 2 h daytime intervals; Estimate annual utilisation distributions from 52 annual trajectories with a dynamic Brownian bridge movement model; Extract poisoning and food availability at each utilisation value, rescaling rasters to 0 to 1 and summing utilisation per cell into occupation probabilities; Fit generalized linear mixed models with a beta family, averaging 10 models with one random annual trajectory per individual; Fit quasi-Poisson generalized linear models for vulture numbers per cell; Test sensitivity to extrapolated Botswana poisoning values},
  results = {Poisoning hotspots in northern Botswana and south-eastern Namibia were also associated with high numbers of vulture mortalities; The largest exposure to intentional poisoning was in north-eastern, central and south-western Botswana; Northern Botswana and the border with South Africa had high food availability, potentially amplifying mortality; Vultures spent similar time in low and high poisoning and food availability areas individually, but the number of vultures was significantly higher in high unintentional poisoning under low food availability, and in high intentional poisoning under high food availability; Hotspots occurred mainly because many individuals used them rather than one intensively},
  equations = {not_applicable},
  software = {move; raster; glmmTMB; AER},
  limitations = {Unintentional poisoning data were unavailable for Botswana and were extrapolated from the best knowledge available, so this extrapolation should be borne in mind when interpreting results; The food availability layer includes livestock and wild herbivores but not butcheries or vulture restaurants, which are expected to affect vulture movements; Identified hotspots depend on the space use of the study species, so the number of individuals, populations and species included affects the results},
  keywords = {GPS tracking; Human-wildlife conflict; Resource availability; Sentinel poisoning; Space use; Torgos tracheliotos; Vultures; Poisoning risk},
  category = {NA},
}

@article{dias2019threats,
  title = {Threats to seabirds: a global assessment},
  author = {Dias, Maria P and Martin, Rob and Pearmain, Elizabeth J and Burfield, Ian J and Small, Cleo and Phillips, Richard A and Yates, Oliver and Lascelles, Ben and Borboroglu, Pablo Garcia and Croxall, John P},
