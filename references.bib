@article{phillips2024incidental,
  title = {Incidental mortality of seabirds in trawl fisheries: A global review},
  author = {Phillips, Richard A and Fox, Emma and Crawford, Rory and Prince, Stephanie and Yates, Oliver},
  journal = {Biological Conservation},
  volume = {296},
  pages = {110720},
  year = {2024},
  publisher = {Elsevier},
  doi = {10.1016/j.biocon.2024.110720},
  url = {https://doi.org/10.1016/j.biocon.2024.110720},
  month = {jul},
  abstract = {Seabirds are amongst the most threatened taxa in the world, often due to incidental mortality (bycatch) in fisheries. Hundreds of thousands are thought to be killed worldwide in gillnets and longlines each year, but global mortality in trawl fisheries is unknown. Based on our comprehensive review, bycatch totals from cable strikes and net captures were available for only 25 fisheries. Bycatch rates were highly variable, precluding substitution from monitored to unmonitored fisheries to estimate bycatch totals, and total fishing effort was often unknown, which is also a prerequisite for scaling bycatch rates to estimate total birds killed. Ten, seven and one trawl fishery were known to catch of the order of 100s, 1000s and 10,000s of birds, respectively, and total bycatch from all monitored fisheries sums to ∼44,000 birds per year. However, given the scale of cryptic mortality and the many unmonitored or poorly monitored fisheries, the actual global mortality in trawl fisheries will be much higher. The most bycaught species were albatrosses and large petrels (many of which are threatened) in the Southern Hemisphere, and gannets in the Northern Hemisphere. The few long-term studies indicated that mitigation measures (particularly strategic offal management and bird-scaring lines) were effective at reducing bycatch rates. Much improved regulations, and close monitoring of compliance and bycatch rates are essential for ensuring trawl fisheries do not continue to have major impacts on vulnerable seabird populations.},
  island = {Global},
  species = {Albatrosses, Petrels, Gannets},
  time_period = {1996-2021},
  research_question = {What is the global scale of seabird bycatch in trawl fisheries? How effective are mitigation measures in reducing this bycatch in the most affected species and regions?},
  objectives = {To estimate a global total of seabird bycatch in trawl fisheries, To conduct a gap analysis, To identify the seabird families and species that are most susceptible to bycatch in trawl fisheries, To compare bycatch totals or fishery-wide bycatch rates before and after the introduction of mitigation measures},
  variables = {Seabird bycatch rates, Bycatch totals, Fishing effort, Species affected, Geographical regions, Mitigation measures, Observer coverage, Data gaps and uncertainties, Cryptic mortality, Life-history characteristics of seabirds},
  analytical_methods = {Literature Review, Data Extraction, Standardization of Bycatch Rates, Gap Analysis, Species Susceptibility Analysis, Assessment of Mitigation Measures},
  results = {Global Seabird Bycatch Estimate: 44,000 seabirds per year, Variation in Bycatch Rates: Highly variable across different trawl fisheries, Geographical Distribution of Bycatch: Australia, New Zealand, South America, and southern Africa, Species Most Affected: Albatrosses, large petrels, and gannets, Effectiveness of Mitigation Measures: Offal management and Bird Scaring Lines are effective, Data Gaps: European and Asian waters, Monitoring Challenges: Observer coverage is 10% of fishing effort, Implications for Conservation: Seabird bycatch in trawl fisheries is one of the highest threats to seabird populations globally},
  equations = {NA},
  software = {NA},
  limitations = {Data Gaps and Incomplete Coverage, Variability in Bycatch Rates, Low Observer Coverage, Cryptic Mortality, Inconsistent Reporting and Monitoring Protocols, Limited Regional Focus, Dependence on Existing Literature},
  keywords = {Albatrosses, Bycatch mitigation, Cryptic mortality, Fishing effort, Gannets, Global bycatch, Petrels, Seabird bycatch, Seabirds, Threatened species, Trawl fisheries},
  category = {State of the art},
}

